# SocialMate environment variables: NAMES ONLY. Never put real values in this file.
#
# Local setup: copy this file to .env.local (gitignored) and fill it in, or pull
# the development values from Vercel with:  npx vercel env pull .env.local
# Production values live in the Vercel project settings.

# Supabase (required for anything to load)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=
ADMIN_EMAIL=
CRON_SECRET=
INTERNAL_CRON_TOKEN=
INTERNAL_SECRET=
WEBHOOK_SECRET=

# Payments (Stripe) and shop
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET=
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Email
RESEND_API_KEY=
REPLY_TO_EMAIL=

# AI and media
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
UNSPLASH_ACCESS_KEY=
GIPHY_API_KEY=
HUNTER_API_KEY=

# Platforms (OAuth apps)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin HQ reads RenewalMate's database
RENEWALMATE_SUPABASE_URL=
RENEWALMATE_SUPABASE_SERVICE_ROLE_KEY=

# Legacy (Enki is out of SocialMate; still read by old code paths)
ENKI_ENCRYPTION_KEY=
GITHUB_TOKEN=
